# ============================================================================
# SIGAB Frontend & Backend Production Environment Configuration Example
# Salin file ini menjadi .env saat melakukan deployment ke server produksi
# ============================================================================

# --- Frontend (Vite) ---
# URL Backend API (tanpa garis miring di akhir). Kosongkan jika menggunakan proxy lokal.
VITE_API_URL=https://api-sigab.domain-anda.id

# URL WebSocket Backend (opsional, otomatis diturunkan dari VITE_API_URL jika dikosongkan)
VITE_WS_URL=wss://api-sigab.domain-anda.id

# --- Backend (FastAPI) ---
ENVIRONMENT=production
FRONTEND_URL=https://sigab.domain-anda.id
SECRET_KEY=ganti-dengan-secret-key-produksi-minimal-32-karakter-acak
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sigab_db
REDIS_URL=redis://localhost:6379/0
