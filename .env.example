# Environment Variables Example — SiagaBencana
# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Lingkungan Aplikasi ('development', 'staging', 'production') ---
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/siagabencana
# Untuk development lokal dengan SQLite:
# DATABASE_URL=sqlite:///./siagabencana.db

# --- JWT Authentication (Pengamanan Secret Key) ---
# PERINGATAN: Di production, SECRET_KEY WAJIB minimal 32 karakter (256-bit entropy).
# Generate key aman di terminal dengan perintah:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_64_karakter_hex_acak_minimal_256_bit_disini
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Pengetatan Aturan CORS ---
# Domain frontend utama
FRONTEND_URL=http://localhost:5173

# Daftar domain origin CORS yang diizinkan (pisahkan dengan koma).
# DILARANG menggunakan '*' di lingkungan production saat credentials aktif!
# Contoh untuk produksi resmi Kabupaten Bojonegoro:
# CORS_ALLOWED_ORIGINS=https://siagabencana.bojonegorokab.go.id,https://sigab.bpbd.bojonegorokab.go.id
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://siagabencana.bojonegorokab.go.id,https://sigab.bpbd.bojonegorokab.go.id

# --- External APIs (Hidrometeorologi & Navigasi) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com/v1
OSRM_BASE_URL=http://router.project-osrm.org
EXTERNAL_API_TIMEOUT_SECONDS=8.0

# --- Frontend Variables (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
