# Environment Variables Example — Backend app/.env.example

# Lingkungan ('development', 'staging', 'production')
ENVIRONMENT=development

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/siagabencana
# DATABASE_URL=sqlite:///./siagabencana.db

# JWT Authentication
# Di production, SECRET_KEY WAJIB minimal 32 karakter (256-bit).
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_64_karakter_hex_acak_minimal_256_bit_disini
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Pengetatan CORS Domain Produksi
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://siagabencana.bojonegorokab.go.id,https://sigab.bpbd.bojonegorokab.go.id

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com/v1
OSRM_BASE_URL=http://router.project-osrm.org
EXTERNAL_API_TIMEOUT_SECONDS=8.0
